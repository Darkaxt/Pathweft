<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>PackageProbe</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Pathweft"><HintPath>$(PathweftAssembly)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
