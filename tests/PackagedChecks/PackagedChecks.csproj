<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>PackageProbe</StartupObject>
    <PathweftDirectory>$([System.IO.Path]::GetDirectoryName('$(PathweftAssembly)'))</PathweftDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Dependency117Checks.cs" Link="Dependency117Checks.cs" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(PathweftDirectory)/Microsoft.Web.WebView2.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf"><HintPath>$(PathweftDirectory)/Microsoft.Web.WebView2.Wpf.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Pathweft"><HintPath>$(PathweftAssembly)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
