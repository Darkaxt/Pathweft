<Window x:Class="FileExplorer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help — File Labs" Width="620" Height="700" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="#E8EEF6" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="#B30A0D13">
    <DockPanel Margin="18,14,18,14">
      <Border DockPanel.Dock="Top" Background="#12FFFFFF" CornerRadius="6" Margin="0,0,0,12">
        <Grid>
          <TextBlock x:Name="FindHint" Text="Find a key or a feature" Foreground="#66FFFFFF" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="Find" Background="Transparent" BorderThickness="0" Foreground="#E8EEF6" CaretBrush="#E8EEF6" Padding="6,6" TextChanged="Find_Changed"/>
        </Grid>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Sections"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
