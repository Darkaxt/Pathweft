<Window x:Class="FileExplorer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help — Pathweft" Width="900" Height="740" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="{DynamicResource Palette.E8EEF6}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="{DynamicResource Palette.B30A0D13}">
    <!-- shown once the empty window is on screen (HelpWindow.xaml.cs) -->
    <DockPanel x:Name="Body" Margin="18,14,18,14" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Palette.12FFFFFF}" CornerRadius="6" Margin="0,0,0,12">
        <Grid>
          <TextBlock x:Name="FindHint" Text="Find a key or a feature" Foreground="{DynamicResource Palette.66FFFFFF}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="Find" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Palette.E8EEF6}" CaretBrush="#E8EEF6" Padding="6,6" TextChanged="Find_Changed"/>
        </Grid>
      </Border>
      <!-- the topics: a click jumps to one -->
      <ScrollViewer DockPanel.Dock="Left" Width="190" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel x:Name="Topics"/>
      </ScrollViewer>
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Sections" Margin="0,0,8,0"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
