<!-- PREVIEW-41: one preview card. In one pane it is docked inside the pane, under its tab row; in two panes each
     pane has its own, as picture in picture over its list; either can float in its own window (MainWindow.PlaceCard). -->
<Border x:Class="FileExplorer.PreviewCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Visibility="Collapsed" Background="{DynamicResource Palette.0DFFFFFF}" CornerRadius="10"
        BorderThickness="1" BorderBrush="{DynamicResource Palette.1AFFFFFF}" ClipToBounds="True">
  <DockPanel>
    <DockPanel x:Name="PreviewHeader" DockPanel.Dock="Top" Margin="12,6,6,4">
      <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
              x:Name="PreviewCloseButton" AutomationProperties.Name="Close preview" MinWidth="32" MinHeight="32"
              ToolTip="Close the preview (Alt+P)" Click="Close_Click"/>
      <Button x:Name="PreviewWindowButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="10"
              MinWidth="32" MinHeight="32" AutomationProperties.Name="Open preview in a floating window" ToolTip="Open preview in a floating window" Click="Window_Click"/>
      <Button x:Name="PreviewPipButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinWidth="32" MinHeight="32"
              AutomationProperties.Name="Picture in picture inside Pathweft" ToolTip="Picture in picture inside Pathweft" Click="Pip_Click">
        <Viewbox Width="12" Height="12">
          <Canvas Width="24" Height="24">
            <Path Data="M3,4 H21 V20 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
            <Path Data="M12,11 H19 V18 H12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Canvas>
        </Viewbox>
      </Button>
      <Button x:Name="PreviewPinButton" DockPanel.Dock="Right" Style="{StaticResource CompactCommand}" Width="32" Height="32" MinWidth="32" MinHeight="32" Content="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="10"
              AutomationProperties.Name="Pin this preview" ToolTip="Pin this preview" Click="Pin_Click"/>
      <!-- OPUS-08: mark the image shown (the Marked images collection) and step through the marked ones -->
      <Button x:Name="PreviewMarkButton" DockPanel.Dock="Right" Style="{StaticResource CompactCommand}" Width="32" Height="32" MinWidth="32" MinHeight="32" Content="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="11"
              Visibility="Collapsed" AutomationProperties.Name="Mark this image" ToolTip="Mark this image" Click="Mark_Click"/>
      <Button x:Name="PreviewMarkNextButton" DockPanel.Dock="Right" Style="{StaticResource CompactCommand}" Width="26" Height="32" MinWidth="26" MinHeight="32" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="9"
              Visibility="Collapsed" AutomationProperties.Name="Next marked image" ToolTip="Next marked image" Click="MarkNext_Click"/>
      <Button x:Name="PreviewMarkPrevButton" DockPanel.Dock="Right" Style="{StaticResource CompactCommand}" Width="26" Height="32" MinWidth="26" MinHeight="32" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="9"
              Visibility="Collapsed" AutomationProperties.Name="Previous marked image" ToolTip="Previous marked image" Click="MarkPrev_Click"/>
      <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=PreviewAppIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Image x:Name="PreviewAppIcon" Stretch="Uniform" AutomationProperties.Name="Preview renderer icon"/>
      </Grid>
      <TextBlock x:Name="PreviewTitle" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <ContentControl x:Name="PreviewBody" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </DockPanel>
</Border>
