<UserControl x:Class="FileExplorer.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileExplorer">
  <UserControl.Resources>
    <Style x:Key="SearchMatchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="27"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ToggleButton">
          <Border x:Name="MatchBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MatchBorder" Property="Background" Value="{DynamicResource Palette.14FFFFFF}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="MatchBorder" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MatchBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- the chevrons between path segments: a Ghost button with less room around the glyph -->
    <Style x:Key="Chevron" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="3,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.14FFFFFF}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ReadOnlyLock">
      <Viewbox IsHitTestVisible="False">
        <Grid Width="24" Height="24">
          <Ellipse Fill="{DynamicResource Palette.20242A}" Stroke="{DynamicResource Palette.D0D4DC}" StrokeThickness="1.5"/>
          <Path Stroke="{DynamicResource Palette.E8EEF6}" StrokeThickness="2" Data="M8,11 L8,8 A4,4 0 0 1 16,8 L16,11"/>
          <Path Fill="{DynamicResource Palette.E8EEF6}" Data="M6,10 L18,10 18,19 6,19 Z"/>
          <Path Stroke="{DynamicResource Palette.20242A}" StrokeThickness="2" Data="M12,13 L12,16"/>
        </Grid>
      </Viewbox>
    </DataTemplate>
    <Style x:Key="ReadOnlyLockStyle" TargetType="ContentControl">
      <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlyLock}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Visibility"><Setter.Value><Binding Path="IsReadOnly"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="NameCell">
      <!-- a DockPanel, not a horizontal StackPanel: the name gets the column's width, so a long name is
           trimmed and the rename box scrolls to its end instead of running on, cut off, past the column -->
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CutDim}">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}" VerticalAlignment="Center" Opacity="0.9">
            <TextBlock.Visibility><Binding Path="NoSmallIcon"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility>
          </TextBlock>
          <Image Source="{Binding DisplaySmallIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" RenderOptions.BitmapScalingMode="HighQuality"/> <!-- sync badge (Google Drive, Nextcloud, ...) -->
          <ContentControl Tag="ReadOnlyLock" Content="{Binding}" Style="{StaticResource ReadOnlyLockStyle}" Width="8" Height="8"/>
        </Grid>
        <Grid>
          <!-- not hit-testable: a right-click landing on one of its Runs made the list drop a multi-selection -->
          <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{DynamicResource Palette.70FFFFFF}" FontSize="11"/></TextBlock>
          <Border Background="{DynamicResource Palette.F2151A22}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="{DynamicResource Palette.FFFFFF}" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.45" IsInactiveSelectionHighlightEnabled="True"
                     IsVisibleChanged="Rename_Shown" PreviewKeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="WidgetNameCell">
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CutDim}">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}"/>
          <Image Source="{Binding DisplaySmallIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}"/>
          <ContentControl Content="{Binding}" Style="{StaticResource ReadOnlyLockStyle}" Width="8" Height="8"/>
        </Grid>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="WidgetLocationCell"><TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Opacity="0.65" VerticalAlignment="Center" Margin="8,0"/></DataTemplate>
    <DataTemplate x:Key="WidgetDateCell"><TextBlock Text="{Binding DateText}" TextTrimming="CharacterEllipsis" Opacity="0.65" VerticalAlignment="Center" TextAlignment="Right"/></DataTemplate>
    <DataTemplate x:Key="WidgetSizeCell">
      <TextBlock Text="{Binding SizeText}" TextTrimming="CharacterEllipsis" Opacity="0.65" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsDir}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </DataTemplate>
    <Style x:Key="WidgetResultRow" TargetType="ListViewItem" BasedOn="{StaticResource ItemTip}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource Palette.E8EEF6}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="4,5">
          <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Palette.10FFFFFF}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSelect}"/><Setter Property="Foreground" Value="{DynamicResource AccentSelectText}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentEdge}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="SizeCell">
      <TextBlock Text="{Binding SizeText}" Opacity="0.7" Typography.NumeralAlignment="Tabular" TextAlignment="Right" Margin="0,0,6,0"/>
    </DataTemplate>
    <DataTemplate x:Key="DateCell">
      <StackPanel Orientation="Horizontal">
        <Border Background="{Binding AgeBrush}" CornerRadius="3" Width="46" Margin="0,0,8,0">
          <TextBlock Text="{Binding Age}" Foreground="{Binding AgeTextBrush}" FontSize="11" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </Border>
        <TextBlock Text="{Binding DateText}" Opacity="0.6" Typography.NumeralAlignment="Tabular"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TileCell">
      <StackPanel>
        <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}"
              Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}" HorizontalAlignment="Center" Style="{StaticResource CutDim}">
          <!-- either the shell thumbnail or, until it arrives, a dim placeholder glyph — never both -->
          <Viewbox Margin="16" Opacity="0.35">
            <Viewbox.Visibility>
              <Binding Path="NoThumb"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
            </Viewbox.Visibility>
            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}"/>
          </Viewbox>
          <Image Source="{Binding DisplayThumb}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality"/>
          <ContentControl Tag="ReadOnlyLock" Content="{Binding}" Style="{StaticResource ReadOnlyLockStyle}" Width="24" Height="24" Margin="2"/>
        </Grid>
        <Border Height="5" Width="34" CornerRadius="2.5" Background="{Binding AgeBrush}" Margin="0,4,0,3" HorizontalAlignment="Center"/>
        <Grid>
          <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="11.5"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility></TextBlock>
          <Border Background="{DynamicResource Palette.F2151A22}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="{DynamicResource Palette.FFFFFF}" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.45" IsInactiveSelectionHighlightEnabled="True"
                     IsVisibleChanged="Rename_Shown" PreviewKeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ListCell">
      <DockPanel Width="230">
        <Border DockPanel.Dock="Left" Width="6" Margin="0,0,6,0" CornerRadius="2" Background="{Binding AgeBrush}"/>
        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CutDim}">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconBrush}" VerticalAlignment="Center" Opacity="0.9">
            <TextBlock.Visibility><Binding Path="NoSmallIcon"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility>
          </TextBlock>
          <Image Source="{Binding DisplaySmallIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image Source="{Binding Overlay}" RenderOptions.BitmapScalingMode="HighQuality"/> <!-- sync badge (Google Drive, Nextcloud, ...) -->
          <ContentControl Tag="ReadOnlyLock" Content="{Binding}" Style="{StaticResource ReadOnlyLockStyle}" Width="8" Height="8"/>
        </Grid>
        <Grid>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><TextBlock.Visibility><Binding Path="NotRenaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></TextBlock.Visibility></TextBlock>
          <Border Background="{DynamicResource Palette.F2151A22}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="-4,-1,0,-1">
            <Border.Visibility><Binding Path="Renaming"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Border.Visibility>
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Bare}" Foreground="{DynamicResource Palette.FFFFFF}" FontWeight="SemiBold"
                     SelectionBrush="{DynamicResource Accent}" SelectionOpacity="0.45" IsInactiveSelectionHighlightEnabled="True"
                     IsVisibleChanged="Rename_Shown" PreviewKeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_Done" Tag="{Binding}"/>
          </Border>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
  <!-- The active pane's glow: its edge again, thicker and blurred, under the card. Kept apart from the
       card so the blur touches only this line — an effect on the card would render the whole list
       through it, on every scroll. -->
  <Border x:Name="Glow" CornerRadius="10" BorderThickness="2.5" Opacity="0" IsHitTestVisible="False">
    <Border.Effect><BlurEffect Radius="12"/></Border.Effect>
  </Border>
  <Border x:Name="Card" Background="{DynamicResource Palette.0DFFFFFF}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Palette.1AFFFFFF}">
    <DockPanel>
      <!-- Tabs -->
      <!-- tabs share the row equally (browser-style): full width until they don't fit, then all shrink -->
      <!-- The dark strip is painted by everything AROUND the active tab (left edge, inactive tabs, the
           + area, the rest of the row). The active tab paints nothing, so it is exactly the panel's
           own surface and flows into the path bar below — no colour to keep in sync. -->
      <Grid x:Name="TabsArea" DockPanel.Dock="Top">
      <!-- one shape for the whole strip, with the active tab's silhouette cut out of it: rounded
           top corners flaring outwards at the bottom, the way a browser (and FilePilot) draws tabs.
           The cut-out shows the panel's own surface, so the active tab always matches it exactly. -->
      <!-- in a Canvas so its size (set by hand from the band's) never feeds back into the row's height:
           otherwise a strip drawn for three rows of tabs kept the row that tall after the pane widened -->
      <Canvas><Path x:Name="StripShape" Fill="{DynamicResource TabStripBg}"/></Canvas>
      <DockPanel x:Name="TabBand" AllowDrop="True" Background="Transparent" SizeChanged="TabBand_SizeChanged" MouseDown="TabBand_MouseDown" DragOver="Tabs_DragOver" DragLeave="Tabs_DragLeave" Drop="Tabs_Drop">
        <Border DockPanel.Dock="Left" Width="4"/>
        <UniformGrid x:Name="TabStrip" DockPanel.Dock="Left" Rows="1"/>
        <Border x:Name="NewTabBox" DockPanel.Dock="Left" Padding="4,4,4,2">
          <Button x:Name="NewTabButton" Style="{StaticResource Ghost}" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                  ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
        </Border>
        <!-- under the window's buttons, when this pane is the one at the top right (MainWindow.PlaceCaption) -->
        <Border x:Name="CaptionSpace" DockPanel.Dock="Right" Width="0" Background="Transparent"/>
        <Border/>
      </DockPanel>
      <!-- where a dragged tab would land; an overlay, so the tabs never move under the pointer -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="TabDropLine" Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
      </Canvas>
      </Grid>

      <!-- Path: breadcrumbs, editable on click in empty area / Ctrl+L -->
      <DockPanel x:Name="PathBar" DockPanel.Dock="Top" Margin="8,4,8,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Back (Alt+Left) · middle-click: in a new tab" Click="Back_Click" Tag="back" PreviewMouseDown="Nav_MiddleClick"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Forward (Alt+Right) · middle-click: in a new tab" Click="Fwd_Click" Tag="fwd" PreviewMouseDown="Nav_MiddleClick"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="10" ToolTip="Up (Backspace) · middle-click: in a new tab" Click="Up_Click" Tag="up" PreviewMouseDown="Nav_MiddleClick"/>
        <Border x:Name="AddressField" Background="{DynamicResource Palette.12FFFFFF}" CornerRadius="5" Padding="6,2" MinHeight="30"
                ToolTip="Enter a path or search with Everything. This PC searches all indexed files." MouseLeftButtonDown="Crumbs_Click">
        <DockPanel>
          <StackPanel x:Name="MatchToggles" DockPanel.Dock="Right" Orientation="Horizontal" Margin="5,0,0,0">
            <ToggleButton x:Name="MatchCase" Content="Aa" Style="{StaticResource SearchMatchToggle}" ToolTip="Match case" AutomationProperties.Name="Match case" Checked="MatchOptions_Changed" Unchecked="MatchOptions_Changed"/>
            <ToggleButton x:Name="MatchWord" Style="{StaticResource SearchMatchToggle}" ToolTip="Match whole word" AutomationProperties.Name="Match whole word" Checked="MatchOptions_Changed" Unchecked="MatchOptions_Changed"><TextBlock Text="Ab" TextDecorations="Underline"/></ToggleButton>
            <ToggleButton x:Name="MatchPath" Content="..\" Style="{StaticResource SearchMatchToggle}" ToolTip="Match path" AutomationProperties.Name="Match path" Checked="MatchOptions_Changed" Unchecked="MatchOptions_Changed"/>
            <ToggleButton x:Name="MatchRegex" Content=".*" FontWeight="Bold" Style="{StaticResource SearchMatchToggle}" ToolTip="Regular expression" AutomationProperties.Name="Regular expression" Checked="MatchOptions_Changed" Unchecked="MatchOptions_Changed"/>
          </StackPanel>
        <Grid>
          <Border Background="Transparent" ClipToBounds="True" PreviewMouseDown="Crumbs_MiddleClick">
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="FilterHint" Text="Enter a path or search this folder" Foreground="{DynamicResource Palette.99FFFFFF}" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          <TextBox x:Name="FilterBox" Style="{StaticResource Bare}" Visibility="Collapsed" Margin="4,3"
                   AutomationProperties.Name="Address or Everything search" PreviewKeyDown="PathBox_PreviewKeyDown" TextChanged="Filter_Changed" LostKeyboardFocus="PathBox_Lost"/>
          <!-- folder suggestions while typing a path; it opens the way Windows opens menus (fade, slide or none) -->
          <Popup x:Name="Suggest" PlacementTarget="{Binding ElementName=FilterBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                 PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
            <Border Background="{DynamicResource Palette.F2161B24}" BorderBrush="{DynamicResource Palette.2EFFFFFF}" BorderThickness="1" CornerRadius="6" Padding="3"
                    MinWidth="{Binding ActualWidth, ElementName=FilterBox}">
              <ListBox x:Name="SuggestList" Focusable="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Palette.E8EEF6}"
                       MaxHeight="320" PreviewMouseLeftButtonDown="Suggest_MouseDown">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Padding="8,4" CornerRadius="4" Background="Transparent"><ContentPresenter/></Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.1AFFFFFF}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/><Setter Property="Foreground" Value="{DynamicResource AccentSelectText}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Border>
          </Popup>
        </Grid>
        </DockPanel>
        </Border>
      </DockPanel>
      <TextBlock x:Name="SearchCoverage" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="14,0,14,5" Foreground="{DynamicResource Palette.B3FFFFFF}" FontSize="11" TextWrapping="Wrap"/>
      <Button x:Name="MoreResults" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="10,3" Content="Load next 200 results" Style="{StaticResource Ghost}" Click="MoreResults_Click"/>

      <!-- Drive usage. Also a place for the current folder itself, between the address bar and the files:
           drop here and it goes into this folder whatever is selected, click here and the selection clears. -->
      <Border x:Name="FolderStrip" DockPanel.Dock="Top" Padding="10,6,10,4" Background="Transparent" CornerRadius="4" Margin="4,0"
              AllowDrop="True" ToolTip="Drop here to put files in this folder · click to clear the selection"
              MouseLeftButtonDown="FolderStrip_Click" DragEnter="FolderStrip_DragEnter" DragLeave="FolderStrip_DragLeave">
      <DockPanel>
        <TextBlock x:Name="DriveInfoText" DockPanel.Dock="Right" Foreground="{DynamicResource Palette.80FFFFFF}" FontSize="11" Margin="10,0,0,0"
                   Typography.NumeralAlignment="Tabular"/>
        <Grid VerticalAlignment="Center" Height="3">
          <Border Background="{DynamicResource Palette.1AFFFFFF}" CornerRadius="1.5"/>
          <Border x:Name="UsedBar" Background="{DynamicResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left"/>
        </Grid>
      </DockPanel>
      </Border>

      <DockPanel DockPanel.Dock="Bottom" Margin="14,2,8,5">
        <!-- sorting, reachable in every view mode (the column headers only exist in Details) -->
        <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Click="SortButton_Click" ToolTip="Sort">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="SortIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,6,0"/>
            <TextBlock x:Name="SortName"/>
          </StackPanel>
        </Button>
        <Button x:Name="ViewButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Click="ViewButton_Click" ToolTip="View (Ctrl+Shift+1…5)">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ViewIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,1,6,0"/>
            <TextBlock x:Name="ViewName"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="Footer" Foreground="{DynamicResource Palette.80FFFFFF}" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      </DockPanel>

      <Grid>
      <!-- drag-to-select rectangle, drawn over the list so the rows never move under it -->
      <Canvas x:Name="MarqueeLayer" Panel.ZIndex="1" IsHitTestVisible="False" Margin="4,0" ClipToBounds="True">
        <!-- Details: where Name ends. A press right of it, on any row, starts a selection rectangle (PlaceNameEdge) -->
        <Rectangle x:Name="NameEdge" Width="1" Fill="{DynamicResource Palette.18FFFFFF}" Visibility="Collapsed"/>
        <Border x:Name="Marquee" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentEdge}" BorderThickness="1" CornerRadius="2" Visibility="Collapsed"/>
        <!-- middle-click autoscroll: where the click was, as in a browser; the arrows say which ways it scrolls -->
        <Grid x:Name="AutoscrollMark" Width="30" Height="30" Visibility="Collapsed">
          <Ellipse Fill="{DynamicResource Palette.D91A1F29}" Stroke="{DynamicResource Palette.B3FFFFFF}" StrokeThickness="1.5"/>
          <Path x:Name="AutoscrollUpDown" Fill="{DynamicResource Palette.E6FFFFFF}" Data="M15,4.5 L19,9.5 L11,9.5 Z M15,25.5 L19,20.5 L11,20.5 Z"/>
          <Path x:Name="AutoscrollSides" Fill="{DynamicResource Palette.E6FFFFFF}" Data="M4.5,15 L9.5,11 L9.5,19 Z M25.5,15 L20.5,11 L20.5,19 Z"/>
          <Ellipse Width="4" Height="4" Fill="{DynamicResource Palette.E6FFFFFF}"/>
        </Grid>
      </Canvas>
      <!-- ScrollUnit=Pixel keeps virtualization but scrolls smoothly instead of jumping a row at a time -->
      <local:FileList x:Name="List" AlternationCount="2" Background="Transparent" BorderThickness="0" Margin="4,0"
                TextSearch.TextPath="Name" VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <!-- Group by date (Details): a quiet heading per group, its count, and a rule to the edge -->
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <DockPanel Margin="6,10,8,4">
                  <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
                    <DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger> <!-- the ".." group -->
                  </Style.Triggers></Style></DockPanel.Style>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="12"/>
                  <TextBlock Text="{Binding ItemCount}" Foreground="{DynamicResource Palette.8A97AA}" FontSize="11" Margin="8,0,10,0" VerticalAlignment="Center"/>
                  <Border Height="1" Background="{DynamicResource Palette.1FFFFFFF}" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn x:Name="NameColumn" Header="Name" Width="200" CellTemplate="{StaticResource NameCell}"/>
            <GridViewColumn Header="Version" Width="80">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Version}" Opacity="0.55" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="50">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Ext}" Opacity="0.55"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Size" Width="80" CellTemplate="{StaticResource SizeCell}"/>
            <GridViewColumn Header="Modified" Width="170" CellTemplate="{StaticResource DateCell}"/>
          </GridView>
        </ListView.View>
      </local:FileList>
      </Grid>
    </DockPanel>
  </Border>
  </Grid>
</UserControl>
