<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- only for the notification-area icon (Settings → close to the notification area); WinForms ships with the
         desktop runtime already, so the app gets no bigger. Its namespace stays out of the global usings. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pathweft</AssemblyName>
    <Product>Pathweft</Product>
    <Company>Darkaxt</Company>
    <Version>1.1.41</Version>
    <!-- WPF windows without their own Icon use this one, so every window gets it -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup and requires manifest DPI awareness. The WinForms
         analyzer assumes a Forms ApplicationConfiguration entry point; Forms
         is referenced only for desktop clipboard/tray APIs in this WPF host. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;installer\**;.local\**</DefaultItemExcludes>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Program.Main: a second launch hands off before WPF loads (App.xaml.cs) -->
    <StartupObject>FileExplorer.Program</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <ExcludeSevenZipAssemblies>true</ExcludeSevenZipAssemblies>
    <OfficeCoreRuntimeRoot Condition="'$(OfficeCoreRuntimeRoot)' == ''">$(OfficeRuntimeRoot)\core-sets\s16-20261106</OfficeCoreRuntimeRoot>
    <OfficeRuntimeManifest Condition="'$(OfficeRuntimeManifest)' == ''">$(MSBuildProjectDirectory)\vendor\Office\runtime-manifest.json</OfficeRuntimeManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="MaintenanceGuidance.json" />
    <None Update="scripts\Maintenance-Windows.ps1" Link="Maintenance-Windows.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ShellRouterRoot)\x64\PathweftShell.dll" Link="PathweftShell-$(Version)-x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ShellRouterRoot)\x86\PathweftShell.dll" Link="PathweftShell-$(Version)-x86.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(EverythingRuntimeRoot)\Everything.exe" Link="Everything\Everything.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(EverythingRuntimeRoot)\Everything.lng" Link="Everything\Everything.lng" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(EverythingRuntimeRoot)\License.txt" Link="Everything\License.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(F3DRuntimeRoot)\bin\*.dll" Link="F3D\bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SevenZipRuntimeRoot)\7z.dll" Link="SevenZip\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RarsRuntimeRoot)\pathweft_rars.dll" Link="Rars\pathweft_rars.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(F3DRuntimeRoot)\bin\vcruntime140.dll" Link="Rars\vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MpvRuntimeRoot)\*.dll" Link="MPV\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MpvRuntimeRoot)\MPV-BUILDINFO.json" Link="MPV\MPV-BUILDINFO.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(OfficeCoreRuntimeRoot)\**\*.dll" Link="Office\cores\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(OfficeRuntimeRoot)\libreoffice\runtime\**\*" Link="Office\LibreOffice\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="native\office\libreoffice\worker.py" Link="Office\libreoffice-worker.py" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="vendor\Office\licenses\**\*" />
    <None Include="vendor\Office\licenses\**\*" Link="Office\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="vendor\Office\runtime-manifest.json" />
    <None Include="$(OfficeRuntimeManifest)" Link="Office\runtime-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Office\libreoffice-runtime-manifest.json" Link="Office\libreoffice-runtime-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Office\license-manifest.json" Link="Office\license-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MpvRuntimeRoot)\licenses\**\*" Link="MPV\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MediaInfoRuntimeRoot)\MediaInfo.dll" Link="runtimes\win-x64\native\MediaInfo.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MediaInfoRuntimeRoot)\licenses\*.txt" Link="licenses\MediaInfo\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SevenZipRuntimeRoot)\License.txt" Link="SevenZip\License.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(F3DRuntimeRoot)\share\licenses\**\*" Link="F3D\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Include="tests\Dependency117Checks.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="tests\UpdateProgressObserver.cs" Condition="'$(Configuration)' == 'Debug'" />
    <None Include="vendor\EverythingSDK\Everything64.dll" CopyToOutputDirectory="PreserveNewest" Link="Everything64.dll" />
    <None Include="vendor\**\*.txt" Exclude="vendor\Office\licenses\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Marked\LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Performance\source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\SysOptimizer\source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Scoop\source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="vendor\Win11Debloat\source-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="docs\PERFORMANCE-MCP.md" Link="Performance-MCP.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="COPYING-GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.11" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="ELFSharp" Version="2.17.3" />
    <PackageReference Include="Prefetch" Version="2026.5.2" />
    <PackageReference Include="QuickLook.MediaInfo" Version="26.5.0" />
    <!-- The donor netstandard asset omits its required public.xml resource.
         The same pinned package's net462 asset includes it and has no extra
         runtime dependency. Qualify that assembly on the current .NET host. -->
    <PackageReference Include="QuickLook.ApkReader" Version="2.1.0" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
    <Reference Include="QuickLook.ApkReader">
      <HintPath>$(PkgQuickLook_ApkReader)\lib\net462\QuickLook.ApkReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.2" />
    <Reference Include="SharpSevenZip">
      <HintPath>$(SharpSevenZipRuntimeRoot)\SharpSevenZip.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <!-- The F4 editor: Monaco and the page hosting it, loaded from the app folder -->
    <None Include="Editor\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- the sidebar shows the app icon where the title bar used to -->
    <Resource Include="app.ico" />
    <Resource Include="vendor\Office\icons\*.ico" />
    <!-- What's new: every release's notes, read from inside the exe (WhatsNewWindow.cs) -->
    <EmbeddedResource Include="whatsnew.txt" LogicalName="whatsnew.txt" />
    <!-- From 1.0.46, the banner of the month a release came out (the studio's collage, 1920 x 340) -->
    <EmbeddedResource Include="banners\month-*.png" LogicalName="whatsnew-%(Filename).png" />
  </ItemGroup>
</Project>
