<Window x:Class="FileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileExplorer"
        Title="Pathweft" Width="1400" Height="860" Background="Transparent"
        Foreground="{DynamicResource Palette.E8E8E8}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <!-- No Windows title bar: the tabs take the top row, the window's buttons sit at its right end, and the
       empty part of the tab row (and the sidebar's name) moves the window. GlassFrameThickness -1 keeps the
       DWM frame, so the acrylic, the shadow and the rounded corners stay. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- minimize / maximize / close and the history button: Windows 11's sizes and glyphs -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Palette.D0FFFFFF}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.18FFFFFF}"/></Trigger>
              <!-- the maximize button is hit-tested by Windows (snap layouts), so WPF never sees the mouse over it -->
              <Trigger Property="Tag" Value="hover"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.18FFFFFF}"/></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Uid" Value="close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.C42B1C}"/>
                <Setter Property="Foreground" Value="White"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Compact sidebar utility icons; Drop bin remains at the bottom. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CommandDivider" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="{DynamicResource Palette.20FFFFFF}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="StatSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="StatIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,5,12,0"/>
    </Style>
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Palette.08FFFFFF}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Palette.14FFFFFF}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,9,14,9"/>
    </Style>
    <Style x:Key="PerformanceCard" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Card" Style="{StaticResource StatCard}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Palette.14FFFFFF}"/></Trigger>
          <Trigger Property="Tag" Value="on"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- the transfer window's buttons: big, filled and labelled, so they are found at a glance; Tag="on" is the
         accent one (the default answer) -->
    <Style x:Key="JobAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Palette.F0FFFFFF}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource Palette.1FFFFFFF}" BorderBrush="{DynamicResource Palette.26FFFFFF}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Palette.33FFFFFF}"/></Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelect}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentSelectText}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the conflict choices: four equal buttons on one row, text only, smaller than the job's own buttons -->
    <Style x:Key="JobChoice" TargetType="Button" BasedOn="{StaticResource JobAction}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- One Ferry job: its chart colour, progress, figures and any decision needed. -->
    <DataTemplate x:Key="JobCard">
      <!-- Content is opaque at its first layout; automatic window growth never
           reveals a card held transparent by an entrance animation. -->
      <Border x:Name="TransferCard" Style="{StaticResource AuxiliaryCard}" Padding="12" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="13" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0"/>
            <Border Width="6" Height="6" Background="{Binding Hue}" CornerRadius="3" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Grid Margin="0,8,0,0" TextBlock.FontSize="11" TextBlock.Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TransferCompleted" Text="{Binding CompletedFilesText}"/>
            <TextBlock x:Name="TransferTotal" Grid.Column="1" Text="{Binding TotalFilesText}" Margin="12,0,0,0"/>
          </Grid>
          <ProgressBar x:Name="TransferProgress" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding Hue}" Height="6" Margin="0,4,0,10" AutomationProperties.Name="Overall transfer progress"/>
          <TextBlock Text="{Binding ErrorSummary}" ToolTip="{Binding ErrorDetail}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                     Visibility="{Binding HasTransferErrors, Converter={StaticResource Vis}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasTransferErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TransferError}"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Expander Header="Details" Visibility="{Binding HasErrors, Converter={StaticResource Vis}}" Margin="0,2,0,8" Foreground="{DynamicResource Muted}">
            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" Margin="0,6,0,2" FontSize="11"/>
          </Expander>
          <!-- Current work/outcomes on the left; separately centered glyphs and labels on the right. -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="TransferPause" Style="{StaticResource JobAction}" Visibility="{Binding Copying, Converter={StaticResource Vis}}" Click="JobPause_Click" AutomationProperties.Name="{Binding PauseText}">
                <local:TransferActionLabel Glyph="{Binding PauseGlyph}" Text="{Binding PauseText}"/></Button>
              <Button x:Name="TransferCancel" Style="{StaticResource JobAction}" Margin="0" Visibility="{Binding Active, Converter={StaticResource Vis}}" Click="JobCancel_Click" AutomationProperties.Name="Cancel transfer">
                <local:TransferActionLabel Glyph="&#xE711;" Text="Cancel"/></Button>
              <Button x:Name="TransferUndo" Style="{StaticResource JobAction}" Visibility="{Binding CanUndo, Converter={StaticResource Vis}}" Click="JobUndo_Click" AutomationProperties.Name="Undo transfer">
                <local:TransferActionLabel Glyph="&#xE7A7;" Text="Undo"/></Button>
              <Button x:Name="TransferDismiss" Style="{StaticResource JobAction}" Margin="0" Visibility="{Binding Finished, Converter={StaticResource Vis}}" Click="JobDismiss_Click" AutomationProperties.Name="Dismiss transfer">
                <local:TransferActionLabel Glyph="&#xE73E;" Text="Dismiss"/></Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding Current}" ToolTip="{Binding Current}" Visibility="{Binding Copying, Converter={StaticResource Vis}}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Stats}" ToolTip="{Binding Stats}" Visibility="{Binding HasStats, Converter={StaticResource Vis}}" Foreground="{DynamicResource Muted}" FontSize="11" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>

          <StackPanel Visibility="{Binding HasConflicts, Converter={StaticResource Vis}}" Margin="0,10,0,0">
            <TextBlock Text="{Binding ConflictTitle}" Foreground="{DynamicResource Palette.E8EEF6}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConflictScope}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="ShowMatchingConflicts" Content="{Binding MatchingConflictsLabel}" IsChecked="{Binding ShowMatchingConflicts, Mode=TwoWay}" Visibility="{Binding HasMatchingConflicts, Converter={StaticResource Vis}}" Margin="0,8,0,0"
                      ToolTip="Matching size and date do not prove identical contents. Choices still apply to every file."/>
            <ListView x:Name="ConflictTable" ItemsSource="{Binding ConflictRows}" Height="{Binding ConflictHeight}" Margin="0,8,0,8" Background="Transparent" BorderThickness="0" SizeChanged="ConflictTable_SizeChanged"
                      AutomationProperties.Name="Files already in the destination" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{DynamicResource Palette.E8EEF6}"/><Setter Property="Padding" Value="8,2"/>
                <Setter Property="ToolTip" Value="{Binding Detail}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                  <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><GridViewRowPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding ExistingNewer}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PreviewWarning}"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Palette.0DFFFFFF}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSelect}"/><Setter Property="Foreground" Value="{DynamicResource AccentSelectText}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentEdge}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ListView.ItemContainerStyle>
              <ListView.View><GridView AllowsColumnReorder="False">
                <GridViewColumn Header="File" Width="220"><GridViewColumn.CellTemplate><DataTemplate>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ReviewHint}" FontSize="11"/></StackPanel>
                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Incoming" Width="140"><GridViewColumn.CellTemplate><DataTemplate>
                  <StackPanel Margin="0,3"><TextBlock Text="{Binding IncomingSize}" Visibility="{Binding SizeDiffers, Converter={StaticResource Vis}}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding IncomingTime}" Visibility="{Binding TimeDiffers, Converter={StaticResource Vis}}" TextWrapping="Wrap" FontSize="11" Typography.NumeralAlignment="Tabular"/></StackPanel>
                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Existing" Width="140"><GridViewColumn.CellTemplate><DataTemplate>
                  <StackPanel Margin="0,3"><TextBlock Text="{Binding ExistingSize}" Visibility="{Binding SizeDiffers, Converter={StaticResource Vis}}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding ExistingTime}" Visibility="{Binding TimeDiffers, Converter={StaticResource Vis}}" TextWrapping="Wrap" FontSize="11" Typography.NumeralAlignment="Tabular"/></StackPanel>
                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              </GridView></ListView.View>
            </ListView>
            <TextBlock Text="No size or date differences. You can show matching files above." Visibility="{Binding NoConflictDifferences, Converter={StaticResource Vis}}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
            <UniformGrid Rows="1" Margin="0,0,-6,0">
              <Button Style="{StaticResource JobChoice}" Tag="on" Click="JobResolve_Click" CommandParameter="Rename" Content="Keep both"/>
              <Button Style="{StaticResource JobChoice}" Click="JobResolve_Click" CommandParameter="Newer"><TextBlock Text="Replace if newer" TextWrapping="Wrap" TextAlignment="Center"/></Button>
              <Button Style="{StaticResource JobChoice}" Click="JobResolve_Click" CommandParameter="Overwrite" Content="Replace"/>
              <Button Style="{StaticResource JobChoice}" Click="JobResolve_Click" CommandParameter="Skip" Content="Skip"/>
            </UniformGrid>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>


  </Window.Resources>

  <!-- Dark tint over the acrylic keeps text readable on bright wallpapers -->
  <Grid x:Name="Root" Background="{DynamicResource Palette.B30A0D13}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="160" MaxWidth="600"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <!-- the picture from Settings → Background image, over the tint and under everything else -->
    <Grid x:Name="BgLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
      <Image x:Name="BgImage" Stretch="UniformToFill"/>
      <Rectangle x:Name="BgShade"/> <!-- brightness: black or white over the picture -->
    </Grid>

    <!-- Sidebar: a bit more opaque, it sits over whatever is behind the window -->
    <DockPanel x:Name="SidebarPanel" Background="{DynamicResource Palette.40000000}">
      <!-- the app's name, where the title bar used to say it; it moves the window like one -->
      <Grid x:Name="SidebarHeader" DockPanel.Dock="Top" Margin="8,10,8,0" SizeChanged="SidebarHeader_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel x:Name="SidebarBrand" Background="Transparent" MouseDown="Caption_MouseDown" Height="28" ToolTip="Pathweft">
          <Image Source="/app.ico" Width="16" Height="16" Margin="8,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Pathweft" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <StackPanel x:Name="SidebarHeaderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="UpdateButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE895;" Click="CheckUpdates_Click"
                ToolTip="Check for updates (it also checks by itself every hour)" AutomationProperties.Name="Check for updates"/>
        <Button x:Name="WhatsNewButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE789;" Click="WhatsNew_Click" ToolTip="What&#x2019;s new" AutomationProperties.Name="What&#x2019;s new"/>
        <Button x:Name="HelpButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE897;" Click="Help_Click" ToolTip="Help: everything Pathweft does (F1)" AutomationProperties.Name="Help"/>
        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"/>
        </StackPanel>
      </Grid>
      <DockPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="8,4,8,3">
        <!-- the Drop bin: a click shows it, and files dropped on the button go in -->
        <Button x:Name="BinButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="Auto" HorizontalAlignment="Left"
                Click="BinButton_Click" AutomationProperties.Name="Drop bin" AllowDrop="True" DragOver="Bin_DragOver" Drop="Bin_Drop"
                ToolTip="Drop bin: collect files from several folders, then copy or move them all at once (Ctrl+B adds the selection)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7B8;" VerticalAlignment="Center"/>
            <TextBlock x:Name="BinCount" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Accent}"/>
          </StackPanel>
        </Button>
      </DockPanel>
      <!-- Drop bin: files gathered from anywhere, sent together to the active pane's folder -->
      <Border x:Name="DropBin" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="8,4,8,0" Padding="10,8" CornerRadius="8"
              Background="{DynamicResource Palette.0DFFFFFF}" BorderBrush="{DynamicResource Palette.1AFFFFFF}" BorderThickness="1" AllowDrop="True" DragOver="Bin_DragOver" Drop="Bin_Drop">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Content="&#xE711;"
                    ToolTip="Hide the Drop bin (what is in it stays)" AutomationProperties.Name="Hide the Drop bin" Click="BinButton_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" FontSize="11" Content="Clear" ToolTip="Empty the Drop bin (the files stay where they are)" Click="BinClear_Click"/>
            <TextBlock Text="Drop bin" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="BinSummary" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>
          <StackPanel x:Name="BinActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Style="{StaticResource Tab}" Tag="on" Click="BinCopy_Click" Content="Copy here"/>
            <Button Style="{StaticResource Tab}" Click="BinMove_Click" Content="Move here"/>
          </StackPanel>
          <!-- virtualized: only the rows in sight are made (MainWindow.ShowBin) -->
          <ItemsControl x:Name="BinList" MaxHeight="190" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False"><ItemsPresenter/></ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,1,0,1" ToolTip="{Binding Path}">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                          ToolTip="Take it out of the bin" AutomationProperties.Name="{Binding RemoveName}" Click="BinRemove_Click"/>
                  <Border Width="16" Height="16" Margin="0,0,8,0" Loaded="BinIcon_Loaded"/>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" Padding="8,12"
                    Loaded="SidebarScroll_Loaded" ScrollChanged="SidebarScroll_Changed" SizeChanged="SidebarScroll_SizeChanged">
        <!-- Sections (Quick access / Favorites / Drives) are added by SidebarSections.cs, in the
             order the user dragged them into; each one collapses and both are remembered. -->
        <Grid>
        <StackPanel x:Name="SidebarHost">
          <!-- declared here so the code can find them by name; BuildSidebar moves each one into its section -->
          <StackPanel x:Name="QuickAccess"/>
          <TextBlock x:Name="QuickHint" Text="Ctrl+D pins a folder here" Foreground="{DynamicResource Palette.59FFFFFF}" FontSize="11" Margin="8,2,0,0"/>
          <StackPanel x:Name="Favorites"/>
          <StackPanel x:Name="Drives"/>
          <StackPanel x:Name="FolderTree"/>
        </StackPanel>
        <!-- drop position while reordering sections: drawn over the list, so it never moves anything -->
        <Canvas IsHitTestVisible="False">
          <Border x:Name="DropLine" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
        </Canvas>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <!-- drag to resize the sidebar -->
    <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeBehavior="CurrentAndNext"
                  DragCompleted="SidebarSplitter_DragCompleted"/>

    <!-- the panes first: their tabs are the window's top row; the summary cards sit under them -->
    <Grid Grid.Column="1" Margin="10,8,10,0">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Stats for the active pane: the drive, the folder, and the selection (or the latest change).
           Settings can make them one line each, or hide them (ApplyStats). -->
      <Grid x:Name="StatsRow" Grid.Row="1" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.25*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource StatCard}" x:Name="DriveCard">
          <DockPanel>
            <TextBlock x:Name="DriveIcon" Text="&#xEDA2;" Style="{StaticResource StatIcon}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
              <DockPanel>
                <TextBlock x:Name="DrivePct" DockPanel.Dock="Right" Style="{StaticResource StatSub}" Typography.NumeralAlignment="Tabular"/>
                <TextBlock Style="{StaticResource StatSub}"><Run x:Name="StatDrive" FontWeight="SemiBold" Foreground="{DynamicResource Palette.E8EEF6}"/><Run x:Name="StatFs"/></TextBlock>
              </DockPanel>
              <TextBlock TextTrimming="CharacterEllipsis"><Run x:Name="StatFree" FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><Run Text="  free" Foreground="{DynamicResource Muted}" FontSize="11"/><Run x:Name="StatUsed" Foreground="{DynamicResource Muted}" FontSize="11"/></TextBlock>
              <!-- how full the drive is: the sidebar's bar, across the card; red with a glow past 90% -->
              <Grid x:Name="DriveBar" Height="4" Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{DynamicResource Palette.12FFFFFF}" CornerRadius="2"/>
                <Border x:Name="DriveFill" CornerRadius="2" Background="{DynamicResource Accent}"/>
              </Grid>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border x:Name="FolderCard" Grid.Column="2" Style="{StaticResource StatCard}">
          <DockPanel>
            <TextBlock x:Name="FolderIcon" Text="&#xE8B7;" Style="{StaticResource StatIcon}" Foreground="{DynamicResource Palette.EBCB7A}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="This folder" Style="{StaticResource StatSub}"/>
              <TextBlock x:Name="StatFolder" Style="{StaticResource StatValue}"/>
              <TextBlock x:Name="StatFolderSub" Style="{StaticResource StatSub}" Typography.NumeralAlignment="Tabular"/>
              <!-- what the folder is made of, by size: images, video, archives, programs, code… -->
              <Grid x:Name="KindBar" Height="4" Margin="0,5,0,0" Background="{DynamicResource Palette.12FFFFFF}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border x:Name="SelectionCard" Grid.Column="4" Style="{StaticResource StatCard}">
          <DockPanel>
            <TextBlock x:Name="SelIcon" Text="&#xE8B3;" Style="{StaticResource StatIcon}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SelTitle" Style="{StaticResource StatSub}"/>
              <TextBlock x:Name="SelValue" Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SelSub" Style="{StaticResource StatSub}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <Grid x:Name="PaneArea" SizeChanged="PaneArea_SizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition x:Name="PreviewGap" Width="0"/>
          <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
      <Grid x:Name="PaneGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="250"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition MinWidth="250"/>
        </Grid.ColumnDefinitions>
        <!-- drag to resize the two panes; double-click resets 50/50 -->
        <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                      MouseDoubleClick="PaneSplitter_Reset"/>
        <local:PaneView x:Name="Left"/>
        <local:PaneView x:Name="Right" Grid.Column="2"/>
      </Grid>
      <!-- Preview pane (Alt+P): the active pane's selected file, drawn by Quick View's code -->
      <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                    Visibility="Collapsed" DragCompleted="PreviewSplitter_DragCompleted"/>
      <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Palette.0DFFFFFF}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Palette.1AFFFFFF}" ClipToBounds="True">
        <DockPanel>
          <DockPanel x:Name="PreviewHeader" DockPanel.Dock="Top" Margin="12,6,6,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
                    x:Name="PreviewCloseButton" AutomationProperties.Name="Close preview" MinWidth="32" MinHeight="32"
                    ToolTip="Close the preview (Alt+P)" Click="Preview_Click"/>
            <Button x:Name="PreviewWindowButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="10"
                    MinWidth="32" MinHeight="32" AutomationProperties.Name="Open preview in a floating window" ToolTip="Open preview in a floating window" Click="PreviewWindow_Click"/>
            <Button x:Name="PreviewPipButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinWidth="32" MinHeight="32"
                    AutomationProperties.Name="Picture in picture inside Pathweft" ToolTip="Picture in picture inside Pathweft" Click="PreviewPip_Click">
              <Viewbox Width="12" Height="12">
                <Canvas Width="24" Height="24">
                  <Path Data="M3,4 H21 V20 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                  <Path Data="M12,11 H19 V18 H12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="PreviewPinButton" DockPanel.Dock="Right" Style="{StaticResource CompactCommand}" Width="32" Height="32" MinWidth="32" MinHeight="32" Content="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="10"
                    AutomationProperties.Name="Pin this preview" ToolTip="Pin this preview" Click="PreviewPin_Click"/>
            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=PreviewAppIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <Image x:Name="PreviewAppIcon" Stretch="Uniform" AutomationProperties.Name="Preview renderer icon"/>
            </Grid>
            <TextBlock x:Name="PreviewTitle" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <ContentControl x:Name="PreviewBody" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </DockPanel>
      </Border>
      </Grid>

      <!-- Ferry transfers live in a window of their own (MainWindow.ShowTransfers): under the panes they took the files' room -->

      <!-- Command bar -->
      <DockPanel x:Name="CommandBar" Grid.Row="3" Margin="0,6,0,6" SizeChanged="CommandBar_SizeChanged">
        <!-- the buttons first: a long status message is trimmed, it never pushes the last buttons out -->
        <WrapPanel x:Name="CommandButtons" DockPanel.Dock="Left" Orientation="Horizontal">
          <!-- Create -->
          <Button x:Name="NewFolderCommand" Style="{StaticResource CompactCommand}" Click="MkDir_Click" ToolTip="New folder (F7 or Ctrl+Shift+N)" AutomationProperties.Name="New folder"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.NewFolder}"/></Button>
          <Button x:Name="NewFileCommand" Style="{StaticResource CompactCommand}" Click="NewFile_Click" ToolTip="New file (Ctrl+N)" AutomationProperties.Name="New file"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.NewFile}"/></Button>
          <Border Style="{StaticResource CommandDivider}"/>
          <!-- Selected item -->
          <Button x:Name="OpenCommand" Style="{StaticResource CompactCommand}" Click="Open_Click" ToolTip="Open (F3 or Enter)" AutomationProperties.Name="Open"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Open}"/></Button>
          <Button x:Name="RenameCommand" Style="{StaticResource CompactCommand}" Click="Rename_Click" ToolTip="Rename (F2)" AutomationProperties.Name="Rename"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Rename}"/></Button>
          <Button x:Name="DeleteCommand" Style="{StaticResource CompactCommand}" Click="Delete_Click" ToolTip="Delete (F8 or Delete)" AutomationProperties.Name="Delete"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Delete}"/></Button>
          <Border Style="{StaticResource CommandDivider}"/>
          <!-- Transfers -->
          <Button x:Name="CopyButton" Style="{StaticResource CompactCommand}" Click="Copy_Click" ToolTip="Copy to the other pane (Ctrl+F5). F5 refreshes." AutomationProperties.Name="Copy to the other pane"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Copy}"/></Button>
          <Button x:Name="MoveButton" Style="{StaticResource CompactCommand}" Click="Move_Click" ToolTip="Move to the other pane (F6)" AutomationProperties.Name="Move to the other pane"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Move}"/></Button>
          <Button x:Name="TransfersButton" Style="{StaticResource CompactCommand}" Click="Transfers_Click" Visibility="Collapsed" ToolTip="Transfers" AutomationProperties.Name="Transfers"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Transfers}"/></Button>
          <Border Style="{StaticResource CommandDivider}"/>
          <!-- Tools -->
          <Button x:Name="TerminalCommand" Style="{StaticResource CompactCommand}" Click="Terminal_Click" ToolTip="Open terminal (Ctrl+`)" AutomationProperties.Name="Open terminal"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Terminal}"/></Button>
          <Button x:Name="AnalyzeSpaceCommand" Style="{StaticResource CompactCommand}" Click="AnalyzeSpace_Click" ToolTip="Analyze space in this folder" AutomationProperties.Name="Analyze space"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.AnalyzeSpace}"/></Button>
          <Button x:Name="PerformanceCommand" Style="{StaticResource CompactCommand}" Click="Performance_Click" ToolTip="Show performance" AutomationProperties.Name="Show performance"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Performance}"/></Button>
          <Button x:Name="MaintenanceCommand" Style="{StaticResource CompactCommand}" Click="Maintenance_Click" ToolTip="Maintenance" AutomationProperties.Name="Maintenance"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Maintenance}"/></Button>
          <Border Style="{StaticResource CommandDivider}"/>
          <!-- View -->
          <Button x:Name="HiddenToggle" Style="{StaticResource CompactCommand}" Click="Hidden_Click" ToolTip="Show or hide Windows hidden and dot-prefixed files (Ctrl+H)" AutomationProperties.Name="Show hidden files"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Hidden}"/></Button>
          <Button x:Name="AdministratorCommand" Style="{StaticResource CompactCommand}" Click="Administrator_Click" ToolTip="Standard access — switch to administrator" AutomationProperties.Name="Standard access — switch to administrator"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Administrator}"/></Button>
          <!-- in screen order: first pane, second pane, preview -->
          <Button x:Name="PanesCommand" Style="{StaticResource CompactCommand}" Click="Panes_Click" ToolTip="One pane or two (Ctrl+P)" AutomationProperties.Name="One or two panes"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Panes}"/></Button>
          <Button x:Name="PreviewCommand" Style="{StaticResource CompactCommand}" Click="Preview_Click" ToolTip="Show the selected file beside the panes (Alt+P)" AutomationProperties.Name="Preview pane"><Image Width="16" Height="16" Source="{DynamicResource CommandIcon.Preview}"/></Button>
        </WrapPanel>
        <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Right" Margin="12,0,0,0"/>
      </DockPanel>
    </Grid>

    <!-- the window's buttons, over the right end of the tab row (the pane under them keeps that room free) -->
    <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
      <Button x:Name="HistoryButton" Style="{StaticResource Caption}" Width="40" FontSize="13" Content="&#xE81C;" Click="History_Click" AutomationProperties.Name="History"
              ToolTip="Recent folders and closed tabs (Ctrl+Shift+T reopens the last closed tab)"/>
      <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
      <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="Maximize"/>
      <Button Style="{StaticResource Caption}" Uid="close" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"/>
    </StackPanel>
  </Grid>
</Window>
