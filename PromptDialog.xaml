<Window x:Class="FileExplorer.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="{DynamicResource Palette.E8EEF6}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="{DynamicResource Palette.B30A0D13}">
    <StackPanel Margin="{StaticResource AuxiliaryMargin}">
      <TextBlock x:Name="Label" Foreground="{DynamicResource Palette.8A97AA}" Margin="2,0,0,8"/>
      <Border Style="{StaticResource AuxiliaryField}">
        <TextBox x:Name="Input" Style="{StaticResource Bare}" FontSize="13" KeyDown="Input_KeyDown"/>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Style="{StaticResource AuxiliaryAction}" Margin="0,0,6,0" Click="Cancel_Click"/>
        <Button x:Name="OkButton" Style="{StaticResource AuxiliaryAction}" Tag="on" Click="Ok_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
