<Window x:Class="FileExplorer.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update — Pathweft" Width="520" Height="440" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Background="Transparent"
        Foreground="{DynamicResource Palette.E8EEF6}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid x:Name="Root" Background="{DynamicResource Palette.B30A0D13}">
    <Border Style="{StaticResource AuxiliaryCard}" Margin="{StaticResource AuxiliaryMargin}">
    <DockPanel>
      <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource AuxiliaryHeading}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="Sub" DockPanel.Dock="Top" Foreground="{DynamicResource Palette.8A97AA}" Margin="0,0,0,12" TextWrapping="Wrap"/>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock x:Name="Status" Foreground="{DynamicResource Palette.8A97AA}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterButton" Content="Later" Style="{StaticResource AuxiliaryAction}" Margin="0,0,6,0" Click="Later_Click"/>
          <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource AuxiliaryAction}" Tag="on" Click="Update_Click"/>
        </StackPanel>
      </StackPanel>
      <ProgressBar x:Name="Progress" DockPanel.Dock="Bottom" Height="4" Maximum="1" Visibility="Collapsed" Margin="0,10,0,0"/>

      <Border x:Name="NotesCard" Style="{StaticResource AuxiliaryField}" Padding="2">
        <TextBox x:Name="Notes" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource Palette.D6DEEA}" BorderThickness="0"
                 Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </Border>
    </DockPanel>
    </Border>
  </Grid>
</Window>
